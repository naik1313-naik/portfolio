---
import { site, hero, stats } from "../data/site";
---

<section class="relative overflow-hidden" id="banner">
	<canvas id="three-canvas"></canvas>
	<div class="content">
		<div class="left">
			<h1 class="title font-anton">
				<span class="green">{hero.word1}</span>
				<br />
				<span class="indent">{hero.word2}</span>
			</h1>
			<p class="intro" set:html={hero.intro} />
			<a class="cta font-anton" href={hero.ctaLink} target="_blank" rel="noopener noreferrer">
				<span class="wipe"></span>
				<span class="txt">{hero.cta}</span>
			</a>
			<div class="availability">
				<span class="dot"></span>
				<span>{site.status}</span>
			</div>
		</div>
		<div class="stats">
			{
				stats.map((s) => (
					<div class="stat">
						<h5 class="num font-anton">{s.value}</h5>
						<p>{s.label}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import * as THREE from "three";

	const canvas = document.getElementById("three-canvas");
	const section = canvas?.closest(".hero");
	if (canvas && section) {
		const renderer = new THREE.WebGLRenderer({
			canvas,
			antialias: true,
			alpha: true,
		});
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

		const scene = new THREE.Scene();

		const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);
		camera.position.z = 6;

		const shapes = new THREE.Group();
		scene.add(shapes);

		const geometry = new THREE.IcosahedronGeometry(1);
		const material = new THREE.MeshStandardMaterial({
			color: 0x00d92f,
			metalness: 0.6,
			roughness: 0.3,
			wireframe: true,
		});
		const core = new THREE.Mesh(geometry, material);
		core.scale.setScalar(1.4);
		shapes.add(core);

		const ringMat = new THREE.MeshStandardMaterial({
			color: 0x00a7ff,
			metalness: 0.8,
			roughness: 0.2,
			wireframe: true,
		});
		for (let i = 0; i < 3; i++) {
			const r = new THREE.Mesh(new THREE.IcosahedronGeometry(1), ringMat);
			r.scale.setScalar(2.2 + i * 0.6);
			r.position.set(
				Math.sin(i * 2.1) * 3,
				Math.cos(i * 2.1) * 3,
				(i - 1) * -1.5
			);
			r.userData = { speed: 0.003 + i * 0.002, dir: i % 2 === 0 ? 1 : -1 };
			shapes.add(r);
		}

		const particleGeo = new THREE.BufferGeometry();
		const count = 600;
		const positions = new Float32Array(count * 3);
		for (let i = 0; i < count * 3; i++) {
			positions[i] = (Math.random() - 0.5) * 20;
		}
		particleGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
		const particleMat = new THREE.PointsMaterial({
			color: 0xb5b5b5,
			size: 0.03,
		});
		const particles = new THREE.Points(particleGeo, particleMat);
		scene.add(particles);

		scene.add(new THREE.AmbientLight(0xffffff, 0.6));
		const point = new THREE.PointLight(0x00d92f, 2, 20);
		point.position.set(3, 4, 5);
		scene.add(point);

		const pointer = new THREE.Vector2();
		const target = new THREE.Vector2();
		window.addEventListener("pointermove", (e) => {
			target.x = (e.clientX / window.innerWidth) * 2 - 1;
			target.y = -(e.clientY / window.innerHeight) * 2 + 1;
		});

		function resize() {
			const w = section.clientWidth;
			const h = section.clientHeight;
			renderer.setSize(w, h, false);
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
		}

		resize();
		window.addEventListener("resize", resize);

		renderer.setAnimationLoop(() => {
			pointer.x += (target.x - pointer.x) * 0.05;
			pointer.y += (target.y - pointer.y) * 0.05;

			shapes.rotation.x += 0.001;
			shapes.rotation.y += 0.002;
			shapes.rotation.x += pointer.y * 0.02;
			shapes.rotation.y += pointer.x * 0.03;

			shapes.children.forEach((child) => {
				if (child.userData.speed) {
					child.rotation.x += child.userData.speed * child.userData.dir;
					child.rotation.y += child.userData.speed * child.userData.dir;
				}
			});

			particles.rotation.y += 0.0005;
			point.position.x = Math.sin(performance.now() / 2000) * 4;
			point.position.y = Math.cos(performance.now() / 2000) * 4;

			renderer.render(scene, camera);
		});
	}
</script>

<style>
	#banner {
		position: relative;
		min-height: 100svh;
		min-height: 530px;
		display: flex;
		align-items: center;
		overflow: hidden;
	}
	#three-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}
	.content {
		position: relative;
		z-index: 1;
		max-width: 1148px;
		margin: 0 auto;
		width: 100%;
		padding: 3rem 1rem;
		pointer-events: none;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2rem;
	}
	.left {
		pointer-events: auto;
		max-width: 544px;
	}
	.title {
		font-size: clamp(3.5rem, 10vw, 5rem);
		line-height: 0.95;
		margin: 0;
		color: var(--text);
		text-transform: uppercase;
	}
	.title .green {
		color: var(--accent);
	}
	.title .indent {
		margin-left: 1rem;
	}
	.intro {
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.6;
		margin: 1.5rem 0 0;
		max-width: 50ch;
	}
	.intro .hl {
		color: var(--text);
		font-weight: 600;
	}
	.cta {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		height: 48px;
		padding: 0 2rem;
		margin-top: 2.25rem;
		background: var(--accent);
		color: var(--bg);
		text-decoration: none;
		font-size: 1.15rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		overflow: hidden;
	}
	.cta .wipe {
		position: absolute;
		top: 200%;
		left: 0;
		right: 0;
		height: 100%;
		background: #fff;
		border-radius: 50%;
		transform: scale(1.5);
		transition: top 0.5s;
	}
	.cta:hover .wipe {
		top: 0;
	}
	.cta .txt {
		position: relative;
		z-index: 1;
	}
	.availability {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--text);
		flex-shrink: 0;
	}
	.stats {
		display: flex;
		flex-direction: row;
		gap: 2rem;
		margin-top: 2rem;
		text-align: left;
		pointer-events: auto;
	}
	.stat {
		display: flex;
		flex-direction: column;
	}
	.stat .num {
		color: var(--accent);
		font-size: 2.25rem;
		margin: 0 0 0.375rem;
		line-height: 1;
	}
	.stat p {
		color: var(--muted);
		margin: 0;
	}
	@media (min-width: 768px) {
		.content {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
		.stats {
			flex-direction: column;
			text-align: right;
			margin-top: 0;
		}
		.title {
			font-size: 5rem;
		}
		.stat .num {
			font-size: 2.5rem;
		}
	}
	@media (max-width: 767px) {
		.left {
			width: 100%;
		}
		.title .indent {
			margin-left: 0;
		}
		.stats {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
