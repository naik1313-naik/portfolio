---
interface Props {
	title: string;
	children?: any;
}
const { title, children } = Astro.props;
---

<section class="section reveal" id={title.toLowerCase().replace(/\s+/g, "-")}>
	<div class="container">
		<h2 class="section-title">{title}</h2>
		<slot />
	</div>
</section>

<style>
	.section {
		padding: 6rem 1.5rem;
	}
	.container {
		max-width: 76rem;
		margin: 0 auto;
	}
	.section-title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--text);
		margin: 0 0 2.5rem;
		letter-spacing: -0.02em;
	}
</style>
