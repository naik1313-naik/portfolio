---
import { site } from "../data/site";
---

<footer class="footer" id="contact">
	<div class="container">
		<p class="invite">Have a project in mind?</p>
		<a class="email font-anton" href={`mailto:${site.email}`}>{site.email}</a>
		<div class="credit">
			<a href={site.github} target="_blank" rel="noopener noreferrer">
				Design &amp; built by {site.footerCredit}
			</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		text-align: center;
		padding-bottom: 5rem;
	}
	.invite {
		font-size: 1.125rem;
		margin: 0;
	}
	.email {
		display: inline-block;
		margin: 1.25rem 0 2.5rem;
		color: var(--text);
		text-decoration: none;
		font-size: 1.875rem;
		line-height: 1.1;
		word-break: break-all;
	}
	.email:hover {
		text-decoration: underline;
	}
	.credit a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.credit a:hover {
		color: var(--text);
		text-decoration: underline;
	}
</style>
