---
import { experience } from "../data/site";
---

<div class="section py-section reveal" id="my-experience">
	<div class="container">
		<div class="heading">
			<svg class="spin" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
				<g fill="currentColor">
					<path d="M14 0l1.5 5.5L21 0l-2.5 5.9L26 2l-4 5.6L28 8l-6 1 0 0 5 3-6 .5L22 16l-5-1.6L19 21l-5-2-0 0 0 0-5 2 2-6.6L6 16l3-6.5-6-.6 6-2L4 5.3 9 8l-4-3.4L9 8 12 2l-1 5.5L13 1z"/>
					<path d="M14 10.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z"/>
				</g>
			</svg>
			<h2 class="title">My Experience</h2>
		</div>

		<div class="list">
			{
				experience.map((item) => (
					<article class="item">
						<p class="company">{item.company}</p>
						<h3 class="role font-anton">{item.role}</h3>
						<p class="period">{item.period}</p>
					</article>
				))
			}
		</div>
	</div>
</div>

<style>
	.section {
		position: relative;
		padding-top: 150px;
		padding-bottom: 150px;
	}
	.heading {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2.5rem;
		color: var(--text);
	}
	.spin {
		animation: spin 7s linear infinite;
	}
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	.title {
		font-size: 1.25rem;
		text-transform: uppercase;
		margin: 0;
		letter-spacing: 0.02em;
	}
	.list {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}
	.item .company {
		color: var(--muted);
		font-size: 1.25rem;
		margin: 0;
	}
	.item .role {
		font-size: 2.5rem;
		line-height: 1;
		margin: 0.875rem 0 0.625rem;
	}
	.item .period {
		color: var(--muted);
		font-size: 1.125rem;
		margin: 0;
	}
	@media (min-width: 768px) {
		.item .role {
			font-size: 3rem;
		}
	}
</style>
