---
import { projects } from "../data/site";
---

<div class="section pb-section reveal" id="selected-projects">
	<div class="container">
		<div class="heading">
			<svg class="spin" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
				<g fill="currentColor">
					<path d="M14 0l1.5 5.5L21 0l-2.5 5.9L26 2l-4 5.6L28 8l-6 1 0 0 5 3-6 .5L22 16l-5-1.6L19 21l-5-2-0 0 0 0-5 2 2-6.6L6 16l3-6.5-6-.6 6-2L4 5.3 9 8l-4-3.4L9 8 12 2l-1 5.5L13 1z"/>
					<path d="M14 10.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z"/>
				</g>
			</svg>
			<h2 class="title">Selected Projects</h2>
		</div>

		<div class="list">
			{
				projects.map((p, i) => (
					<a class="item" href="#contact">
						<div class="flex">
							<div class="num font-anton">_{String(i + 1).padStart(2, "0")}.</div>
							<div class="details">
								<h4 class="project-title font-anton">
									{p.name}
									<span class="arrow" aria-hidden="true">↑</span>
								</h4>
								<div class="tech">
									{
										p.tech.map((t, ti) => (
											<span class="tag">
												{t}
												{
													ti < p.tech.length - 1 && <span class="dot"></span>
												}
											</span>
										))
									}
								</div>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</div>

<style>
	.section {
		position: relative;
	}
	.heading {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2.5rem;
		color: var(--text);
	}
	.spin {
		animation: spin 7s linear infinite;
	}
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	.title {
		font-size: 1.25rem;
		text-transform: uppercase;
		margin: 0;
		letter-spacing: 0.02em;
	}
	.list {
		display: flex;
		flex-direction: column;
	}
	.item {
		display: block;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
		transition: opacity 0.3s;
	}
	.item:first-child {
		padding-top: 0;
	}
	.item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}
	.flex {
		display: flex;
		gap: 1rem;
	}
	.num {
		color: var(--muted);
		font-size: 1.1rem;
		line-height: 1.8;
	}
	.details {
		flex: 1;
	}
	.project-title {
		font-size: 2.25rem;
		line-height: 1;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 1rem;
		background: linear-gradient(to right, var(--accent) 50%, var(--text) 50%);
		background-size: 200% 100%;
		background-position: right;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transition: background-position 0.7s;
	}
	.item:hover .project-title {
		background-position: left;
	}
	.arrow {
		font-size: 1.5rem;
		opacity: 0;
		transition: opacity 0.3s;
		-webkit-text-fill-color: var(--text);
		color: var(--text);
	}
	.item:hover .arrow {
		opacity: 1;
	}
	.tech {
		margin-top: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		color: var(--muted);
		font-size: 0.75rem;
	}
	.tag {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--surface);
	}
	@media (min-width: 640px) {
		.project-title {
			font-size: 3.5rem;
		}
	}
</style>
