---
import { site } from "../data/site";
---

<div class="sticky top-0 z-40">
	<button class="menu-btn" aria-label="Open menu">
		<span class="line top"></span>
		<span class="line bottom"></span>
	</button>
</div>

<div class="overlay" id="nav-overlay"></div>

<aside class="panel" id="nav-panel">
	<div class="panel-inner">
		<div class="top">
			<div class="social">
				<p class="label">SOCIAL</p>
				<ul>
					<li><a href={site.github} target="_blank" rel="noopener noreferrer">github</a></li>
					<li><a href={site.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a></li>
				</ul>
			</div>
			<div class="menu">
				<p class="label">MENU</p>
				<ul class="menu-list">
					<li><button data-target="#top" style="--dot:#eab308">Home</button></li>
					<li><button data-target="#about-me" style="--dot:#3b82f6">About Me</button></li>
					<li><button data-target="#my-experience" style="--dot:#14b8a6">Experience</button></li>
					<li><button data-target="#selected-projects" style="--dot:#6366f1">Projects</button></li>
				</ul>
			</div>
		</div>
		<div class="contact">
			<p class="label">GET IN TOUCH</p>
			<a href={`mailto:${site.email}`}>{site.email}</a>
		</div>
	</div>
</aside>

<link
	href="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.408.0/lucide.min.js"
	rel="preload"
	as="script"
/>

<script>
	const btn = document.querySelector(".menu-btn");
	const panel = document.querySelector("#nav-panel");
	const overlay = document.querySelector("#nav-overlay");

	const open = () => {
		panel.classList.add("open");
		overlay.classList.add("show");
		btn.classList.add("active");
	};
	const close = () => {
		panel.classList.remove("open");
		overlay.classList.remove("show");
		btn.classList.remove("active");
	};

	btn?.addEventListener("click", () =>
		panel.classList.contains("open") ? close() : open()
	);
	overlay?.addEventListener("click", close);

	document.querySelectorAll(".menu-list button").forEach((b) => {
		b.addEventListener("click", () => {
			const el = document.querySelector(b.dataset.target);
			if (el) el.scrollIntoView({ behavior: "smooth" });
			close();
		});
	});
</script>

<style>
	.menu-btn {
		position: absolute;
		top: 20px;
		right: 20px;
		z-index: 50;
		width: 48px;
		height: 48px;
		background: transparent;
		border: none;
		cursor: pointer;
		display: grid;
		place-items: center;
	}
	.line {
		display: block;
		width: 60%;
		height: 2px;
		background: var(--text);
		border-radius: 999px;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		transition: transform 0.3s;
	}
	.line.top {
		top: 19px;
	}
	.line.bottom {
		top: 27px;
	}
	.menu-btn.active .line.top {
		transform: translateX(-50%) translateY(4px) rotate(45deg);
	}
	.menu-btn.active .line.bottom {
		transform: translateX(-50%) translateY(-4px) rotate(-45deg);
	}
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 30;
		background: rgba(0, 0, 0, 0.7);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s;
		pointer-events: none;
	}
	.overlay.show {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}
	.panel {
		position: fixed;
		top: 0;
		right: 0;
		height: 100dvh;
		width: min(500px, calc(100vw - 3rem));
		background: var(--surface);
		transform: translateX(100%);
		transition: transform 0.6s cubic-bezier(0.77, 0, 0.18, 1);
		z-index: 40;
		overflow-y: auto;
		display: flex;
		align-items: center;
	}
	.panel.open {
		transform: translateX(0);
	}
	.panel-inner {
		width: 100%;
		max-width: 300px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}
	.label {
		color: var(--muted);
		text-transform: uppercase;
		font-size: 0.8rem;
		margin: 0 0 1.25rem;
	}
	.top {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	@media (min-width: 1024px) {
		.top {
			flex-direction: row;
			justify-content: space-between;
			gap: 2rem;
		}
	}
	.social ul,
	.menu-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.social ul li a {
		color: var(--text);
		text-decoration: none;
		font-size: 1.1rem;
		text-transform: capitalize;
	}
	.social ul li a:hover {
		text-decoration: underline;
	}
	.menu-list button {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background: transparent;
		border: none;
		cursor: pointer;
		color: var(--text);
		font-size: 1.25rem;
		font-family: inherit;
		text-align: left;
	}
	.menu-list button::before {
		content: "";
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--dot);
		transition: transform 0.3s;
		flex-shrink: 0;
	}
	.menu-list button:hover::before {
		transform: scale(1.8);
	}
	.contact .label {
		margin-bottom: 1rem;
	}
	.contact a {
		color: var(--text);
		text-decoration: none;
		word-break: break-all;
	}
	.contact a:hover {
		color: var(--accent);
	}
</style>
