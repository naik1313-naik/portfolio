---
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import { site } from "../data/site";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Roboto+Flex:opsz,wght@8..144,100;8..144,400;8..144,500;8..144,600;8..144,700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Your Name — Portfolio</title>
		<meta name="description" content="Portfolio of Your Name." />
	</head>
	<body>
		<Navbar />
		<main>
			<Hero />
			<About />
			<Skills />
			<Experience />
			<Projects />
		</main>
		<Contact />
		<div class="v-email">
			<a href={`mailto:${site.email}`}>{site.email}</a>
		</div>
		<div class="scroll-track" aria-hidden="true">
			<div class="scroll-fill" id="scroll-fill"></div>
		</div>
		<script>
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("visible");
							io.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15 }
			);
			document
				.querySelectorAll(".reveal")
				.forEach((el) => io.observe(el));

			const fill = document.getElementById("scroll-fill");
			const onScroll = () => {
				const h = document.documentElement;
				const total = h.scrollHeight - h.clientHeight;
				const p = total > 0 ? h.scrollTop / total : 0;
				fill.style.transform = `scaleY(${p})`;
			};
			fill.style.transformOrigin = "top";
			window.addEventListener("scroll", onScroll, { passive: true });
			onScroll();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #222222;
		--surface: #303030;
		--text: #dedede;
		--muted: #b5b5b5;
		--border: #3d3d3d;
		--accent: #00d92f;
		--accent-2: #00a7ff;
		--bg-dark: #1a1a1a;
	}
	* {
		box-sizing: border-box;
	}
	.font-anton {
		font-family: "Anton", "Arial", sans-serif;
		font-weight: 400;
	}
	.container {
		width: 100%;
		margin: 0 auto;
		padding: 0 1rem;
		max-width: 1148px;
	}
	.py-section {
		padding-top: 250px;
		padding-bottom: 250px;
	}
	.pb-section {
		padding-bottom: 250px;
	}
	.reveal {
		opacity: 0;
		transform: translateY(40px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}
	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			transform: none;
		}
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: "Roboto Flex", system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.5;
	}
	a {
		color: var(--accent);
	}
	.v-email {
		position: fixed;
		bottom: 8rem;
		left: 0;
		z-index: 5;
		display: none;
	}
	.v-email a {
		padding: 0 0.75rem;
		color: var(--muted);
		text-decoration: none;
		writing-mode: vertical-rl;
		letter-spacing: 1px;
		font-size: 0.875rem;
		transition: color 0.2s;
	}
	.v-email a:hover {
		color: var(--text);
	}
	.scroll-track {
		position: fixed;
		top: 50vh;
		right: 2%;
		transform: translateY(-50%);
		width: 6px;
		height: 100px;
		border-radius: 999px;
		background: var(--surface);
		overflow: hidden;
		z-index: 40;
	}
	.scroll-fill {
		width: 100%;
		height: 100%;
		background: var(--accent);
		border-radius: 999px;
		transform: scaleY(0);
	}
	@media (min-width: 1280px) {
		.v-email {
			display: block;
		}
	}
</style>
